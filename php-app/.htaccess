# Detox Locator — Apache rules. Cloudways runs Nginx in front of Apache on the
# Hybrid stack, so this file is honoured. (Lightning is Nginx-only and never
# reads it — use Hybrid.)

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One hostname: www redirects to the apex, so the canonical tag and the
  # address bar always agree. ACME is excluded so certificate renewal for the
  # www name can still be validated on www.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Page URLs without their trailing slash get one, so each page has exactly
  # one address. Only for paths that are not real files (assets, the API).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-z0-9]{2,5}$ [NC]
  RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

  # Everything that is not a real file goes to the front controller, which
  # renders the page or a 404.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# Includes, templates and partials are never requested directly.
RedirectMatch 404 ^/(app|templates|partials)/

# Never serve config or dev files, wherever one ends up.
<FilesMatch "^(config\.local\.php|config\.sample\.php|config\.php|router\.dev\.php|.*\.jsonl|.*\.log)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Assets carry ?v=<mtime>, so they can be cached hard.
  <FilesMatch "\.(webp|png|svg|ico|woff2|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
